From fa26684733c6d38efd5a8a3d0b1754271332fa43 Mon Sep 17 00:00:00 2001
From: Michiel van Slobbe <michiel.van.slobbe@gmail.com>
Date: Fri, 23 Oct 2026 14:23:54 +0200
Subject: [PATCH] http: use memchr() in Curl_verify_header

Scanning the header line one byte at a time is slower than three
memchr() calls, which check 16-32 bytes per step. The colon search
usually stops after the header name, and it is now only done for lines
that need it.

Keep reporting whichever error comes first in the line.

Follow-up to f228410f77
---
 lib/http.c | 32 ++++++++++++--------------------
 1 file changed, 12 insertions(+), 20 deletions(-)

diff --git a/lib/http.c b/lib/http.c
index c3612f86b3..d9acc743cf 100644
--- a/lib/http.c
+++ b/lib/http.c
@@ -3813,25 +3813,17 @@ CURLcode Curl_verify_header(struct Curl_easy *data,
                             const char *hd, size_t hdlen)
 {
   struct SingleRequest *k = &data->req;
-  size_t i;
-  bool has_colon = FALSE;
-  for(i = 0; i < hdlen; i++) {
-    switch(hd[i]) {
-    case '\0':
-      /* this is bad, bail out */
-      failf(data, "NUL byte in header");
-      return CURLE_WEIRD_SERVER_REPLY;
-    case '\r':
-      if(i < hdlen - 2) {
-        /* CR may only precede the LF, nothing else */
-        failf(data, "Carriage return found in header");
-        return CURLE_WEIRD_SERVER_REPLY;
-      }
-      break;
-    case ':':
-      has_colon = TRUE;
-      break;
-    }
+  const char *nul = memchr(hd, '\0', hdlen);
+  const char *cr = memchr(hd, '\r', nul ? (size_t)(nul - hd) : hdlen);
+  /* CR may only precede the LF, nothing else */
+  if(cr && ((size_t)(cr - hd) < hdlen - 2)) {
+    failf(data, "Carriage return found in header");
+    return CURLE_WEIRD_SERVER_REPLY;
+  }
+  if(nul) {
+    /* this is bad, bail out */
+    failf(data, "NUL byte in header");
+    return CURLE_WEIRD_SERVER_REPLY;
   }
   if(k->headerline < 2)
     /* the first "header" is the status-line and it has no colon */
@@ -3839,7 +3831,7 @@ CURLcode Curl_verify_header(struct Curl_easy *data,
   if(((hd[0] == ' ') || (hd[0] == '\t')) && k->headerline > 2)
     /* line folding, cannot happen on line 2 */
     ;
-  else if(!has_colon) {
+  else if(!memchr(hd, ':', hdlen)) {
     /* this is bad, bail out */
     failf(data, "Header without colon");
     return CURLE_WEIRD_SERVER_REPLY;
-- 
